{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gha-dispatcher",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat",
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SCHEDULER", "class_name": "Scheduler" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Scheduler"] }
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	}
}
